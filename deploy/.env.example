# copy to deploy/.env
POSTGRES_PASSWORD=change-me
PORTOFION_SECRET_KEY=change-me-too
# the URL agents and browsers use to reach this server (shown in /llms.txt and invite links)
PORTOFION_BASE_URL=http://portofion.lan:8000
PORTOFION_PORT=8000
# first start only: creates a superuser if the database has no users
PORTOFION_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PORTOFION_BOOTSTRAP_ADMIN_PASSWORD=change-me-please
PORTOFION_ALLOW_SIGNUP=false
PORTOFION_COOKIE_SECURE=false
WORKERS=2
